diff --git a/src/llama-moecache.cpp b/src/llama-moecache.cpp
index 7005987..e30942e 100644
--- a/src/llama-moecache.cpp
+++ b/src/llama-moecache.cpp
@@ -83,6 +83,13 @@ struct moe_cache {
     std::vector<ggml_backend_buffer_type_t> ctx_bufts; // buffer type of each context in `ctxs` (host tables: CPU)
