From b06d0886789c665efab1a8525b901a836d9c1803 Mon Sep 17 00:00:00 2001
From: andrei <root@i5.local>
Date: Sat, 19 Sep 2026 09:46:13 +0300
Subject: [PATCH 2/5] perf: add AVX2 path for PQ2_0 x Q8_0 vec_dot (was scalar
 without VNNI)

---
 ggml/src/ggml-cpu/arch/x86/quants.c | 32 +++++++++++++++++++++++++++++
 1 file changed, 32 insertions(+)

diff --git a/ggml/src/ggml-cpu/arch/x86/quants.c b/ggml/src/ggml-cpu/arch/x86/quants.c
index 7fc8e77..ae35f34 100644
--- a/ggml/src/ggml-cpu/arch/x86/quants.c
+++ b/ggml/src/ggml-cpu/arch/x86/quants.c
@@ -602,6 +602,38 @@ void ggml_vec_dot_pq2_0_q8_0(int n, float * GGML_RESTRICT s, size_t bs, const vo
         }
         sumf += d0 * sumi;
     }
+#elif defined(__AVX2__)
+    // AVX2 without VNNI: same identity as above, dot((c-1), qy) = dot(c, qy) - sum(qy).
+    // Unpack: widen the 8 packed bytes to 8 x u32, then move the four 2-bit fields of each
+    // byte into the four bytes of its lane, which yields the 32 codes in element order.
+    // maddubs cannot saturate: codes <= 3 and |qy| <= 127, so a pair sum is at most 762.
+    const __m256i m0     = _mm256_set1_epi32(0x03);
+    const __m256i m1     = _mm256_set1_epi32(0x0C);
+    const __m256i m2     = _mm256_set1_epi32(0x30);
+    const __m256i m3     = _mm256_set1_epi32(0xC0);
+    const __m256i ones8  = _mm256_set1_epi8(1);
+    const __m256i ones16 = _mm256_set1_epi16(1);
+    __m256 acc = _mm256_setzero_ps();
+    for (int i = 0; i < nb; i++) {
+        const float d0 = GGML_CPU_FP16_TO_FP32(x[i].d);
+        for (int k = 0; k < 4; k++) {
+            const block_q8_0 * GGML_RESTRICT yb = &y[i * 4 + k];
+            const __m256  d  = _mm256_set1_ps(d0 * GGML_CPU_FP16_TO_FP32(yb->d));
+            const __m256i qy = _mm256_loadu_si256((const __m256i *) yb->qs);
+            const __m256i b  = _mm256_cvtepu8_epi32(_mm_loadl_epi64((const __m128i *) &x[i].qs[k * 8]));
+            const __m256i codes = _mm256_or_si256(
+                _mm256_or_si256(_mm256_and_si256(b, m0), _mm256_slli_epi32(_mm256_and_si256(b, m1), 6)),
+                _mm256_or_si256(_mm256_slli_epi32(_mm256_and_si256(b, m2), 12), _mm256_slli_epi32(_mm256_and_si256(b, m3), 18)));
+            const __m256i p16 = _mm256_sub_epi16(_mm256_maddubs_epi16(codes, qy), _mm256_maddubs_epi16(ones8, qy));
+            const __m256  q   = _mm256_cvtepi32_ps(_mm256_madd_epi16(p16, ones16));
+#if defined(__FMA__)
+            acc = _mm256_fmadd_ps(d, q, acc);
+#else
+            acc = _mm256_add_ps(_mm256_mul_ps(d, q), acc);
+#endif
+        }
+    }
+    sumf = hsum_float_8(acc);
 #else
     for (int i = 0; i < nb; i++) {
         const float d0 = GGML_CPU_FP16_TO_FP32(x[i].d);
-- 
