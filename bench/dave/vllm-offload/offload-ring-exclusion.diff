+    is_offloaded: bool = True
 
 
+def is_offloaded_group(kv_cache_spec: KVCacheSpec) -> bool:
+    """Whether a KV cache group takes part in offloading.
+
+    Mirrors the GPU prefix cache, which skips groups that are not
+    prefix-cacheable when it looks up and restores a hit
+    (HybridKVCacheCoordinator.verify_and_split_kv_cache_groups). The only such
+    spec is CircularBufferSpec: a per-request ring holding the raw keys of the
+    compression group still being filled. Restores land on chunk boundaries,
+    which the CSA+linear layout keeps divisible by the compression ratio, so
+    the ring's open group is empty there and the recomputed tail rewrites
+    every ring row before it is read.
+    """
+    return kv_cache_spec.prefix_cacheable
+
