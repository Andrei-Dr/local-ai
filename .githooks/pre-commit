#!/bin/bash
# Regenerate every generated doc block (bench/docgen.py) and stage the result; block the commit when the patch series and
# research/patches/series.toml disagree. Enable once per clone: git config core.hooksPath .githooks
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
GEN="README.md QUICKSTART.md research/patches/SERIES.md research/patches/README.md"
# shellcheck disable=SC2086  # GEN is a path list
dirty=$(git diff --name-only -- $GEN)
out=$("${DOCGEN_PY:-python3}" bench/docgen.py) || { echo "$out"; echo "pre-commit: fix research/patches/series.toml (see above)"; exit 1; }
[ -z "$out" ] && exit 0
echo "pre-commit: $out"
for f in $GEN; do
  git diff --quiet -- "$f" && continue
  if printf '%s\n' "$dirty" | grep -qx "$f"; then
    echo "pre-commit: $f had unstaged edits and was regenerated; review and stage it, then commit again"; exit 1
  fi
  git add -- "$f"
done
