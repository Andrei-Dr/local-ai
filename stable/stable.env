# STABLE = the configuration we serve. THE single source of truth: stable/build.sh, stable/serve.sh and the generated blocks in
# README.md, QUICKSTART.md and research/patches/SERIES.md (bench/docgen.py) all read this file. Change STABLE here, nowhere else.
STABLE_SINCE="2026-09-24"

# llama.cpp: upstream base + our patch series (research/patches/mainline-series); the result equals box branch tu116-served.
LLAMA_CPP_REPO="https://github.com/ggml-org/llama.cpp"
LLAMA_CPP_BASE="e613ef2"
LLAMA_CPP_SERIES="0001-0030"
LLAMA_CPP_STABLE_TREE="0f14b7837bb43a0b94f957dba249ab346b0f638d"
CMAKE_FLAGS="-DCMAKE_BUILD_TYPE=Release -DGGML_CUDA=ON -DCMAKE_CUDA_ARCHITECTURES=75 -DGGML_CUDA_MMQ_NO_MMA=ON -DGGML_CUDA_FORCE_MMQ=ON -DGGML_CUDA_FA_ALL_QUANTS=ON"

# Model files (see QUICKSTART.md for where each comes from).
MODEL="Qwen3.6-35B-A3B-Uncensored-HauhauCS-Aggressive-K2q6-denseQ4K.gguf"
MTP_HEAD="mtp-Qwen3.6-35B-A3B-Q4_0.gguf"
MTP_VOCAB="mtp-Qwen3.6-35B-A3B-vocab49k.bin"

# Serving: environment switches + llama-server flags. Expert-cache slots per layer depend on the context size (VRAM).
SERVE_ENV="GGML_CUDA_FA_TILE_MIN_BATCH=32 GGML_CUDA_FA_MMA_MAX_KV=4096 GGML_SCHED_MOE_PREFETCH=1 GGML_OP_OFFLOAD_MIN_BATCH=32"
SERVE_ARGS="-ngl 999 -fa on -t 6 -ot exps=CPU --spec-type draft-mtp --spec-draft-n-max 3 -ub 128 -ubp 2048"
SERVE_CTX_DEFAULT="4096"
SERVE_CTX_4096="--moe-expert-cache 21 -b 2048"
SERVE_CTX_12288="--moe-expert-cache 18 -b 4096"
